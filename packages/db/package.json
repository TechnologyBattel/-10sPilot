  "dependencies": {
    "drizzle-orm": "0.38.3",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.3"
  }
}
