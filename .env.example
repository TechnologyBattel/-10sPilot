# ---- shared ----
NODE_ENV=development

# ---- database (Supabase free tier Postgres) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenspilot
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenspilot
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- api (apps/api) ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_SECRET_KEY=change-me

# ---- serp_engine (free) ----
SERPER_API_KEY=
GSC_ACCESS_TOKEN=
GSC_SITE_URL=

# ---- ai (free tier providers) ----
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# ---- citation_monitor (optional, paid engines) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
